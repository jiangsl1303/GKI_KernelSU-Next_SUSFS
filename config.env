# ============================================================================
# KernelSU-Next + SUSFS (2.3.x) for generic Android GKI devices.
#
# This file is the DEFAULT profile. It simply points at a per-kernel profile
# under config/; edit the pointer, or choose another file with the workflow
# input "Config file to build" (config: input).
#
# Available profiles:
#   config/android16-6.12.env   Android 16 / Linux 6.12
#   config/android15-6.6.env    Android 15 / Linux 6.6   <- default
#   config/android14-6.1.env    Android 14 / Linux 6.1
#   config/android13-5.15.env   Android 13 / Linux 5.15
#   config/android13-5.10.env   Android 13 / Linux 5.10
#
# Every variable documented in config/android15-6.6.env can also be overridden
# per-run from the Actions workflow form.
# ============================================================================

CONFIG_ENV=config/android15-6.6.env
