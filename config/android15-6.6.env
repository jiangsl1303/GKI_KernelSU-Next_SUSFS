# ============================================================================
# GKI profile: Android 15 / Linux 6.6  (aosp-mirror/kernel_common @ android15-6.6)
#
# Builds the upstream GKI "common" tree from source with plain make, integrates
# KernelSU-Next (dev branch, which ships SUSFS 2.3.0 built in), builds the
# SUSFS LKM (susfs_guard_lkm.ko) against the same kernel, and packages an
# AnyKernel3 flashable zip. Works on any device whose boot partition accepts a
# GKI kernel flashed over the stock one (Pixel, most GSI/custom-ROM phones via
# KernelFlasher or a custom recovery).
#
# Copy this file to config/<your-device>.env to keep one profile per device.
# ============================================================================

CONFIG_ENV=config/android15-6.6.env

# ------------------------------------------------------------- kernel source --

KERNEL_SOURCE=https://github.com/aosp-mirror/kernel_common
KERNEL_SOURCE_BRANCH=android15-6.6
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Suffix added to artifact names and CONFIG_LOCALVERSION ("" = derive from config)
KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=true

# ---------------------------------------------------------------- toolchain ----
# Verified working pairs (2026-07): kernel_common 5.10/6.1/6.6/6.12 build clean
# with clang from AOSP main-kernel-2025 (r547379).
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_LLVM=true
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=

# Extra make flags. 6.6+ objects to some legacy vendor warnings under newer clang;
# keep them non-fatal.
EXTRA_CMDS:
CUSTOM_CMDS:KCFLAGS=-Wno-error=strict-prototypes

# ------------------------------------------------------------- KernelSU --------
# This repo is specialised for KernelSU-Next; 'none' builds a plain kernel.
KSU_VARIANT=kernelsu-next

# KernelSU-Next ref. 'dev' is the modern tree and the only line carrying the
# built-in SUSFS 2.3.x code (kernel/susfs/*, SUSFS_LKM_VERSION "2.3.0-gki").
# 'legacy' is the pre-GKI tree (for 4.19 and older vendor kernels).
KSU_REF=dev

# KSN dev hooks through kprobes (its Kconfig depends on KPROBES && EXT4_FS).
# Keep 'auto': it resolves kprobes on >= 5.10 and manual hooks below that.
KSU_HOOK_MODE=auto

# --------------------------------------------------------------- SUSFS ---------
# KernelSU-Next ships SUSFS in-tree since it was merged as an LKM
# (kernel/susfs/, loaded at runtime via `ksud insmod`). Enabling this builds
# the module (susfs_guard_lkm.ko) and bundles it into the AnyKernel3 zip.
ENABLE_SUSFS=true

# The SUSFS LKM resolves unexported symbols through kallsyms at load time;
# KALLSYMS_ALL is required or `ksud insmod` fails.
FORCE_KALLSYMS_ALL=true

# Strip -dirty from the kernel release string
REMOVE_DIRTY_STRING=true

# ------------------------------------------------------- GKI-level knobs -------
# Some GKI kernels install extra vendor modules from out/; leave the tree to
# build them (needed for WiFi/audio vendor modules on some devices).
BUILD_MODULES=true

# Android 14+ GKI trees carry android/abi_gki_protected_exports_* which break
# loading of vendor modules after the ABI check; custom flashing does not need
# GKI ABI verification, so drop them for a working build.
REMOVE_PROTECTED_EXPORTS=true

# Enable overlayfs (module mounts / system-as-root writes under KSU)
ADD_OVERLAYFS_CONFIG=true

# Kernel name shown in the manager after loading
KERNEL_NAME_SUFFIX=-GKI-KSUN-SUSFS

# Free-form extra defconfig entries (space separated CONFIG_X=y)
EXTRA_DEFCONFIG=

# Reduce log noise on release builds
DISABLE_CC_WERROR=true
DISABLE_LTO=false

# ------------------------------------------------------------- packaging -------
# AnyKernel3 zip (Image + optional dtbo + susfs_guard_lkm.ko)
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# Also drop the built .ko and Image next to the AnyKernel3 zip as raw artifacts
UPLOAD_RAW_IMAGES=true

# ------------------------------------------------------------- storage ---------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
